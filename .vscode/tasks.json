{
  "tasks": [
    {
      "type": "process",
      "label": "Run: Debug",
      "command": "${workspaceFolder}/build/bin/Debug/ModernBoy.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "none"
    },
    {
      "type": "process",
      "label": "DirectX: fxc.exe build active file (vertex shader)",
      "command": "C:/Program Files (x86)/Windows Kits/10/bin/10.0.22621.0/x64/fxc.exe",
      "args": [
        "/T", "vs_5_0",
        "/Fo", "${workspaceFolder}/shaders/${fileBasenameNoExtension}.cso",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/shaders"
      },
      "group": "build"
    },
    {
      "type": "process",
      "label": "DirectX: fxc.exe build active file (pixel shader)",
      "command": "C:/Program Files (x86)/Windows Kits/10/bin/10.0.22621.0/x64/fxc.exe",
      "args": [
        "/T", "ps_5_0",
        "/Fo", "${fileBasenameNoExtension}.cso",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/shaders"
      },
      "group": "build"
    }
  ],
  "version": "2.0.0"
}
